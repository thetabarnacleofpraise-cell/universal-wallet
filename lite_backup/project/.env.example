# Environment Variables — Template
# Copy to .env and fill with real values.
# NEVER commit real secrets to the repository.

# ==========================================
# FRONTEND (Vite — VITE_ prefix, browser-safe)
# ==========================================

# === Supabase (pre-provisioned in Bolt) ===
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# === Frontend RPC Endpoints (optional — public fallbacks used if unset) ===
# These are used by client-side chain adapters for discovery.
# Do NOT put API-key-bearing URLs here unless you accept they will be visible in the browser bundle.
VITE_ALCHEMY_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_ALCHEMY_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_ALCHEMY_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_ALCHEMY_OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_ALCHEMY_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_ALCHEMY_BSC_RPC_URL=https://bsc-dataseed.binance.org
VITE_ALCHEMY_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
VITE_TRON_RPC_URL=https://api.trongrid.io
VITE_BTC_API_URL=https://blockchain.info
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC

# === Alchemy Account Abstraction / Paymaster (optional) ===
# Enables ERC-4337 sponsored / token-fee transactions on supported EVM chains.
# Format: JSON map of chainId → { policyId, feeTokens[] }
VITE_ALCHEMY_AA_API_KEY=
VITE_ALCHEMY_PAYMASTER_POLICY_IDS=

# ==========================================
# BACKEND (Supabase Edge Function — Deno.env, server-side only)
# These are NOT exposed to the browser.
# Configure these as Supabase Edge Function secrets, NOT in .env
# ==========================================

# === Supabase (pre-provisioned, server-side) ===
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# === BSC Handshake Payment ===
# The BSC USDT payment destination for the handshake.
# This address is controlled by the project owner.
HANDSHAKE_PAYMENT_ADDRESS_BSC=0x86ec4f0323beb13c6856c82830c348c24b24b5f1

# === Server-side RPC endpoints (Edge Function — NOT exposed to browser) ===
# These are used by the edge function for payment verification and asset discovery.
# Set these as Supabase Edge Function secrets.
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY
TRON_RPC_URL=https://tron-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
AVALANCHE_RPC_URL=https://avax-mainnet.g.alchemy.com/v2/YOUR_KEY

# ==========================================
# CEX API Keys (server-side only — never expose in browser)
# These must be used from a Supabase Edge Function, never from the frontend.
# ==========================================
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_PASSPHRASE=
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# COINBASE_PASSPHRASE=
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
